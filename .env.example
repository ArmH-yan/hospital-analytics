# Environment variables for Hospital Analytics
# Copy this file to .env and fill in your values
# Never commit .env to git

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hospital_analytics
DB_USER=postgres
DB_PASS=postgres

# Google Sheets
SPREADSHEET_ID=your_google_spreadsheet_id_here
# Place your service account JSON key at: credentials/gsheets_key.json
