# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Environment
.env
.env.*
# Block all real credential JSONs but keep *.example templates
credentials/gsheets_key.json
credentials/*.json
!credentials/*.json.example
!credentials/*.example
# Fallback: ignore the rest of the credentials dir but not the templates above
credentials/*
!credentials/gsheets_key.json.example
!credentials/*.example

# Data (raw CSVs can be large; generated files not needed in git)
data/raw/
data/cleaned/

# Reports (auto-generated each run)
reports/*.log
reports/*.csv

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Power BI (binary — keep spec docs but not .pbix unless small)
*.pbix
